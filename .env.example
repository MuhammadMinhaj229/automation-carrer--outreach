# ========================================================
# ACIOS System Configuration & Credentials Template
# Copy this file to .env and populate your credentials.
# NEVER commit your actual .env file to public version control!
# ========================================================

# Gmail TLS & IMAP Credentials (SMTP: port 587, IMAP: port 993)
# Generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# SMTP Dispatch Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=False

# Rate Limiting & Safety Pacing
# Cooldown interval between emails in sequential dispatch queue (seconds)
DISPATCH_DELAY_SECONDS=60

# Safety Dry Run Flag (Set to True to simulate SMTP dispatch without sending)
DRY_RUN=False

# Search & Intelligence APIs (Optional)
FIRECRAWL_API_KEY=

# Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
