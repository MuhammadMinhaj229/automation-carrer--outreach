# Copy to .env locally. Never commit real values.
# Generate strong random secrets (>= 32 chars); use different values for each purpose.
ACIOS_BACKEND_API_KEY=replace-with-a-long-random-backend-service-token
ACIOS_MCP_BEARER_TOKEN=replace-with-a-separate-long-random-mcp-token
ACIOS_API_KEY=replace-with-a-separate-long-random-openapi-actions-token
ACIOS_UI_PASSWORD=replace-with-a-unique-long-password
ACIOS_SESSION_SECRET=replace-with-at-least-32-random-bytes
ACIOS_BACKEND_URL=http://127.0.0.1:8000
ACIOS_ENV=development
ACIOS_ALLOWED_ORIGINS=http://localhost:3000

# Primary Persistence (MongoDB Atlas in production; SQLite fallback in local dev)
MONGODB_URI=
MONGODB_DB_NAME=acios_production

# Durable Background Job Queue (Redis)
REDIS_URL=

# Private master-resume storage. Use s3 + a private S3-compatible bucket when
# the API and worker run on separate hosts. Never make this bucket public.
RESUME_STORAGE_BACKEND=local
RESUME_STORAGE_BUCKET=
RESUME_STORAGE_REGION=us-east-1
RESUME_STORAGE_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY belong only on the backend/worker.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email credentials (local or backend secret store only)
GMAIL_USER=
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
DISPATCH_DELAY_SECONDS=60
DRY_RUN=true

# Optional integrations (backend/worker only)
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a compatibility alias; prefer GEMINI_API_KEY.
FIRECRAWL_API_KEY=
REACHER_API_KEY=
