# Local ACIOS defaults. Never put real credentials in this file.
ACIOS_ENV=development
ACIOS_DB_PATH=data/acios.db
DRY_RUN=true

# Candidate profile and local resume are stored as ignored files:
# config/candidate_profile.yaml
# data/resume/master_resume.pdf

# Optional AI and research providers
GEMINI_API_KEY=
GOOGLE_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
REACHER_API_KEY=

# Optional crawling controls
ACIOS_CRAWLER_ALLOWED_HOSTS=
ACIOS_CRAWLER_PREFER_FIRECRAWL=false
ACIOS_CRAWLER_IMPERSONATE_HOSTS=
ACIOS_CURL_IMPERSONATE_BIN=
ACIOS_BROWSER_USE_ENABLED=false
ACIOS_CRAWLER_LOCAL_EGRESS_GUARD=false

# Optional Gmail Drafts integration. No bulk sending is enabled by the local CLI.
GMAIL_USER=
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true

# Optional legacy compatibility adapters only
MONGODB_URI=
MONGODB_DB_NAME=acios_local_compat
REDIS_URL=
RESUME_STORAGE_BACKEND=local
RESUME_STORAGE_BUCKET=
RESUME_STORAGE_REGION=us-east-1
RESUME_STORAGE_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
