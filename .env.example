# Copy to .env locally. Never commit real values.
# Generate strong random secrets; use different values for each purpose.
ACIOS_BACKEND_API_KEY=replace-with-a-long-random-backend-service-token
ACIOS_MCP_BEARER_TOKEN=replace-with-a-separate-long-random-mcp-token
ACIOS_API_KEY=replace-with-a-separate-long-random-openapi-actions-token
ACIOS_UI_PASSWORD=replace-with-a-unique-long-password
ACIOS_SESSION_SECRET=replace-with-at-least-32-random-bytes
ACIOS_BACKEND_URL=http://127.0.0.1:8000
ACIOS_ENV=development
ACIOS_ALLOWED_ORIGINS=http://localhost:3000

# Email credentials (local or backend secret store only)
GMAIL_USER=
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
DISPATCH_DELAY_SECONDS=60
DRY_RUN=true

# Optional integrations
FIRECRAWL_API_KEY=
REACHER_API_KEY=
DATABASE_URL=
# Production uses Postgres. SQLite is supported for local development only.
