# Never send credentials or private user/runtime artifacts into the Docker build context.
.git/
.github/
.env
.env.*
*.env
config/candidate_profile.yaml
config/secrets/
data/
*.db
*.sqlite
*.sqlite3
*.pdf
*.xlsx
*.xls
*.csv
*.parquet

# The Python image does not need the frontend or local build outputs.
web/
node_modules/
**/node_modules/
.venv/
venv/
__pycache__/
**/__pycache__/
.pytest_cache/
.coverage*
htmlcov/
*.egg-info/
dist/
build/
.DS_Store
*.log
scratch/
tmp/
